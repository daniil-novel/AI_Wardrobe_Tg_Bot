APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
MINIAPP_PUBLIC_URL=https://your-tunnel.example
API_HOST_PORT=8000
MINIAPP_HOST_PORT=5173
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

POSTGRES_DB=ai_wardrobe
POSTGRES_USER=ai_wardrobe
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ai_wardrobe:change-me@postgres:5432/ai_wardrobe
SYNC_DATABASE_URL=postgresql+psycopg://ai_wardrobe:change-me@postgres:5432/ai_wardrobe
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=ai_wardrobe
RABBITMQ_DEFAULT_PASS=change-me
CELERY_BROKER_URL=amqp://ai_wardrobe:change-me@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/2

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_IMAGE=google/gemini-2.5-pro
OPENROUTER_MODEL_TEXT=google/gemini-2.5-pro
OPENROUTER_MODEL_IMAGE_GEN=google/gemini-2.5-flash-image
# api = OpenRouter only; runner = local Codex runner only; hybrid = ordered fallback.
# Product-card, avatar and try-on pixel generation always stays on OpenRouter.
AI_EXECUTION_MODE=api
AI_HYBRID_PREFERENCE=runner_first
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=
# none uses saved Codex/ChatGPT auth; ollama or lmstudio enables `codex exec --oss`.
CODEX_CLI_LOCAL_PROVIDER=none
CODEX_CLI_TIMEOUT_SECONDS=180
CODEX_CLI_MAX_OUTPUT_BYTES=1000000
CODEX_CLI_IGNORE_USER_CONFIG=true
# Keep false when saved Codex/ChatGPT auth is available; true forwards only CODEX_API_KEY to the child process.
CODEX_CLI_ALLOW_API_KEY_ENV=false
# Shared random secret used only between the VPS relay and the local runner. Minimum 32 characters.
CODEX_RUNNER_TOKEN=
# Used only by scripts/codex-runner.py on the trusted workstation.
CODEX_RUNNER_SERVER_URL=https://your-domain.example/api
CODEX_RUNNER_JOB_TTL_SECONDS=300
CODEX_RUNNER_WAIT_TIMEOUT_SECONDS=90
CODEX_RUNNER_CLAIM_TIMEOUT_SECONDS=15
CODEX_RUNNER_HEARTBEAT_TTL_SECONDS=40
CODEX_RUNNER_MAX_PAYLOAD_BYTES=16000000
# Фон товарной карточки вещи: white или dark.
PRODUCT_IMAGE_BACKGROUND=white
AI_DAILY_BUDGET_USD=20

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ai-wardrobe-private
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/png,image/webp
SUBSCRIPTIONS_ENABLED=true
ENABLE_BILLING_PAYMENTS=false
ENABLE_MARKETPLACE_SEARCH=false
ENABLE_POLLING_BOT=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=30

API_WORKERS=2
WORKER_CONCURRENCY=2
BOT_HOST_PORT=127.0.0.1:8011

FREE_ITEMS_LIMIT=20
FREE_AI_ANALYSES_PER_MONTH=5
PREMIUM_ITEMS_LIMIT=500
PREMIUM_AI_ANALYSES_PER_MONTH=100
PREMIUM_AVATAR_GENERATIONS_PER_MONTH=2
PREMIUM_TRY_ONS_PER_MONTH=6
PREMIUM_MONTHLY_PRICE_RUB=699
PRO_AVATAR_GENERATIONS_PER_MONTH=5
PRO_TRY_ONS_PER_MONTH=15
PRO_MONTHLY_PRICE_RUB=1490
PROMO_HASH_SECRET=

TELEGRAM_PAYMENT_PROVIDER_TOKEN=
EXTERNAL_PAYMENT_PROVIDER_URL=
